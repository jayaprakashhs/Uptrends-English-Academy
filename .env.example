# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
VITE_SITE_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Persistent database & Authentication)
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Server-side service role key (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CLOUDFLARE R2 OBJECT STORAGE (Student photos & Academy media)
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="uptrends-academy-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.uptrendsacademy.com"

# RESEND TRANSACTIONAL EMAIL CONFIGURATION
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_1234567890abcdef"
# Verified domain sender in Resend (e.g., admissions@uptrendsacademy.com)
RESEND_FROM_EMAIL="admissions@uptrendsacademy.com"
# Academy Staff / Teacher recipient for new application alerts
APPLICATION_NOTIFICATION_EMAIL="uptrendsinstitute@gmail.com"

# OFFICIAL APPROVED FEE STRUCTURE & TERMS PDF
# Must point to an actual valid PDF URL or secure storage object
APPROVED_FEE_STRUCTURE_PDF_URL="https://uptrendsacademy.com/assets/docs/Uptrends_Fee_Structure_and_Terms.pdf"
