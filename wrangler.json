{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptrends-english-academy",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-24",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "APPLICATION_MEDIA",
      "bucket_name": "uptrends-academy-media"
    },
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "uptrends-academy-public"
    }
  ],
  "observability": {
  "enabled": true
},
"upload_source_maps": false
}
